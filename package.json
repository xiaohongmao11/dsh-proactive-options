{
  "name": "dsh-proactive-options",
  "version": "0.1.1",
  "description": "主动回复选项：把需要用户拍板的问题变成可点选项。既可以独立装进 DSH，也可以被 dsh-pet 等宠物插件复用同一份能力。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "core.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "restart.js"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "options",
    "ask",
    "confirm",
    "proactive",
    "choice"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaohongmao11/dsh-proactive-options.git"
  },
  "bugs": {
    "url": "https://github.com/xiaohongmao11/dsh-proactive-options/issues"
  },
  "homepage": "https://github.com/xiaohongmao11/dsh-proactive-options#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
